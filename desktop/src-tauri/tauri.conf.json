{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MiniMax Music3 Studio",
  "version": "0.1.0",
  "identifier": "com.timoncool.minimax-music3-studio",
  "build": {
    "beforeDevCommand": "npm --prefix ../app run dev",
    "beforeBuildCommand": "npm --prefix ../app run build",
    "devUrl": "http://127.0.0.1:3000",
    "frontendDist": "../../app/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MiniMax Music3 Studio",
        "width": 1440,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI2REE4QTAyNDQ4QkYyNDIKUldSQzhvdEVBb3JhdHBuU3JtRTlUb3QzdEdvUE8yNDBxTVk2Z0Nrdm1od0pXSHZRWHBxL2dhVm8K",
      "endpoints": [
        "https://github.com/timoncool/MiniMax-Music3-Studio/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
